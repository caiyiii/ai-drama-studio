generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ProjectStep {
  WORLD
  CHARACTERS
  LOCATIONS
  EPISODES
  SCRIPT
  STORYBOARD
  IMAGES
  VIDEOS
  VOICES
  RENDER
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum GenerationTaskType {
  WORLD
  CHARACTER
  STORY_BIBLE
  SEASON_OUTLINE
  EPISODE_OUTLINE
  SCRIPT
  IMAGE
  VIDEO
  VOICE
  STORYBOARD
}

enum GenerationTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiProviderKind {
  OPENAI_COMPATIBLE
  OPENAI
  DEEPSEEK
  QWEN
  GEMINI
  CLAUDE
}

enum CharacterStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CharacterRelationType {
  FRIEND
  ENEMY
  ALLY
  RIVAL
  MASTER
  DISCIPLE
  FAMILY
  LOVER
  COLLEAGUE
  TEACHER
  STUDENT
  PARTNER
  UNKNOWN
  MASTER_STUDENT
  SUPERIOR_SUBORDINATE
  ACQUAINTANCE
  OTHER
}

enum AiCapability {
  CHAT
  STRUCTURED_OUTPUT
  IMAGE
  VIDEO
  IMAGE_TO_VIDEO
  TTS
  VOICE_CLONE
  MUSIC
  EMBEDDING
}

enum SeasonStatus {
  DRAFT
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum EpisodeStatus {
  DRAFT
  OUTLINED
  SCRIPTING
  READY
  IN_PRODUCTION
  COMPLETED
  ARCHIVED
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  projects    Project[]
  aiProviders AiProvider[]
}

model Project {
  id                     String                   @id @default(cuid())
  name                   String
  description            String?
  genre                  String?
  cover                  String?
  status                 ProjectStatus            @default(DRAFT)
  currentStep            ProjectStep              @default(WORLD)
  userId                 String
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProviderId           String?
  aiProvider             AiProvider?              @relation("ProjectSelectedProvider", fields: [aiProviderId], references: [id], onDelete: Restrict)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  episodes               Episode[]
  characters             Character[]
  locations              Location[]
  assets                 Asset[]
  generationTasks        GenerationTask[]
  world                  World?
  storyBible             StoryBible?
  seasons                Season[]
  ownedProviders         AiProvider[]             @relation("ProviderOwnedByProject")
  characterRelationships CharacterRelationship[]
  aiConfigs              ProjectAiConfig[]

  @@index([aiProviderId])
}

model StoryBible {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  logline          String?
  premise          String?
  theme            String?
  tone             String?
  style            String?
  audience         String?
  storyPromise     String?
  rules            Json?
  timelineSummary  String?
  continuityNotes  String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Season {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  synopsis  String?
  outline   String?
  status    SeasonStatus @default(DRAFT)
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  episodes  Episode[]

  @@unique([projectId, number])
  @@index([projectId])
}

model Episode {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seasonId         String
  season           Season        @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  number           Int
  title            String
  synopsis         String?
  outline          String?
  status           EpisodeStatus @default(DRAFT)
  durationSeconds  Int?
  storyState       Json?
  continuityNotes  String?
  metadata         Json?
  order            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([seasonId, number])
  @@index([projectId])
  @@index([seasonId])
}

model Character {
  id                  String                   @id @default(cuid())
  projectId           String
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worldId             String?
  world               World?                   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  civilizationId      String?
  civilization        Civilization?            @relation(fields: [civilizationId], references: [id], onDelete: SetNull)
  factionId           String?
  faction             Faction?                 @relation(fields: [factionId], references: [id], onDelete: SetNull)
  name                String
  alias               String?
  gender              String?
  age                 Int?
  race                String?
  identity            String?
  role                String?
  description         String?
  personality         String?
  appearance          String?
  background          String?
  motivation          String?
  goal                String?
  conflict            String?
  ability             String?
  personalityProfile  Json?
  appearanceProfile   Json?
  abilities           Json?
  voiceProfile        Json?
  imageProfile        Json?
  metadata            Json?
  status              CharacterStatus          @default(ACTIVE)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  outgoingRelations   CharacterRelationship[]  @relation("CharacterRelationFrom")
  incomingRelations   CharacterRelationship[]  @relation("CharacterRelationTo")

  @@index([projectId])
  @@index([worldId])
  @@index([civilizationId])
  @@index([factionId])
  @@index([projectId, name])
}

model CharacterRelationship {
  id              String                 @id @default(cuid())
  projectId       String
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromCharacterId String
  fromCharacter   Character              @relation("CharacterRelationFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacterId   String
  toCharacter     Character              @relation("CharacterRelationTo", fields: [toCharacterId], references: [id], onDelete: Cascade)
  type            CharacterRelationType
  label           String?
  description     String?
  strength        Int                    @default(3)
  metadata        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([fromCharacterId, toCharacterId, type])
  @@index([projectId])
  @@index([fromCharacterId])
  @@index([toCharacterId])
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      AssetType
  name      String
  url       String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model GenerationTask {
  id         String                @id @default(cuid())
  projectId  String
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       GenerationTaskType
  status     GenerationTaskStatus  @default(PENDING)
  capability AiCapability?
  provider   String?
  model      String?
  input      Json?
  output     Json?
  error      String?
  usage      Json?
  appliedAt  DateTime?
  retryCount Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([projectId])
}

model AiProvider {
  id                 String                 @id @default(cuid())
  name               String
  provider           AiProviderKind
  baseUrl            String
  model              String
  encryptedApiKey    String
  isDefault          Boolean                @default(false)
  enabled            Boolean                @default(true)
  userId             String?
  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId          String?
  ownedByProject     Project?               @relation("ProviderOwnedByProject", fields: [projectId], references: [id], onDelete: SetNull)
  selectedByProjects Project[]              @relation("ProjectSelectedProvider")
  capabilities       AiProviderCapability[]
  models             AiModel[]
  projectAiConfigs   ProjectAiConfig[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([isDefault, enabled])
}

model AiProviderCapability {
  id         String       @id @default(cuid())
  providerId String
  provider   AiProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  capability AiCapability
  enabled    Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([providerId, capability])
  @@index([providerId])
}

model AiModel {
  id               String            @id @default(cuid())
  providerId       String
  provider         AiProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name             String
  modelId          String
  capabilities     AiCapability[]
  enabled          Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  projectAiConfigs ProjectAiConfig[]

  @@unique([providerId, modelId])
  @@index([providerId])
}

model ProjectAiConfig {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capability AiCapability
  providerId String?
  provider   AiProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  modelId    String?
  model      AiModel?     @relation(fields: [modelId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([projectId, capability])
  @@index([projectId])
  @@index([providerId])
}

model World {
  id               String          @id @default(cuid())
  projectId        String          @unique
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  cosmicBackground String?
  coreConflict     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  civilizations    Civilization[]
  histories        WorldHistory[]
  factions         Faction[]
  worldLocations   WorldLocation[]
  powerSystems     PowerSystem[]
  characters       Character[]
}

model Civilization {
  id             String          @id @default(cuid())
  worldId        String
  world          World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  origin         String?
  philosophy     String?
  society        String?
  culture        String?
  technology     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  factions       Faction[]
  worldLocations WorldLocation[]
  characters     Character[]

  @@index([worldId])
}

model WorldHistory {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
}

model Faction {
  id             String        @id @default(cuid())
  worldId        String
  world          World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  civilizationId String?
  civilization   Civilization? @relation(fields: [civilizationId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  type           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  characters     Character[]

  @@index([worldId])
}

model WorldLocation {
  id             String        @id @default(cuid())
  worldId        String
  world          World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  civilizationId String?
  civilization   Civilization? @relation(fields: [civilizationId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  type           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([worldId])
}

model PowerSystem {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rules       Json?
  levels      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
}
