generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ProjectStep {
  WORLD
  CHARACTERS
  LOCATIONS
  EPISODES
  SCRIPT
  STORYBOARD
  IMAGES
  VIDEOS
  VOICES
  RENDER
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum AssetStatus {
  PENDING
  READY
  FAILED
  DELETED
}

enum StoryboardShotAssetRole {
  REFERENCE
  GENERATED
  FINAL
  THUMBNAIL
}

enum ScriptBlockAssetRole {
  REFERENCE
  GENERATED
  FINAL
}

enum AudioAssetRole {
  MUSIC
  SFX
  REFERENCE
  FINAL
}

enum TimelineStatus {
  DRAFT
  PREVIEW_READY
  STALE
  LOCKED
}

enum TimelineTrackType {
  VIDEO
  IMAGE
  DIALOGUE
  MUSIC
  SFX
}

enum TimelineClipType {
  VIDEO
  IMAGE
  AUDIO
}

enum TimelineClipSourceType {
  STORYBOARD_SHOT
  SCRIPT_BLOCK
  EPISODE_AUDIO
  ASSET
}

enum RenderJobStatus {
  QUEUED
  PREPARING
  RENDERING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum RenderJobStage {
  QUEUED
  PREPARING
  ENCODING_VIDEO
  MIXING_AUDIO
  FINALIZING
  COMPLETED
}

enum RenderJobEventType {
  QUEUED
  PREPARING
  FFMPEG_STARTED
  FFMPEG_PROGRESS
  FFMPEG_COMPLETED
  ARTIFACT_CREATED
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum RenderArtifactType {
  EPISODE_VIDEO
}

enum GenerationTaskType {
  WORLD
  CHARACTER
  STORY_BIBLE
  SEASON_OUTLINE
  EPISODE_OUTLINE
  SCRIPT
  IMAGE
  VIDEO
  IMAGE_TO_VIDEO
  VOICE
  TTS
  MUSIC
  SFX
  STORYBOARD
  LOCATION
}

enum GenerationTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiProviderKind {
  OPENAI_COMPATIBLE
  OPENAI
  DEEPSEEK
  QWEN
  GEMINI
  CLAUDE
  FAL
}

enum CharacterStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CharacterRelationType {
  FRIEND
  ENEMY
  ALLY
  RIVAL
  MASTER
  DISCIPLE
  FAMILY
  LOVER
  COLLEAGUE
  TEACHER
  STUDENT
  PARTNER
  UNKNOWN
  MASTER_STUDENT
  SUPERIOR_SUBORDINATE
  ACQUAINTANCE
  OTHER
}

enum AiCapability {
  CHAT
  STRUCTURED_OUTPUT
  IMAGE
  VIDEO
  IMAGE_TO_VIDEO
  TTS
  VOICE_CLONE
  MUSIC
  SFX
  EMBEDDING
}

enum SeasonStatus {
  DRAFT
  PLANNING
  READY
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum EpisodeStatus {
  DRAFT
  OUTLINED
  SCRIPTING
  READY
  IN_PRODUCTION
  COMPLETED
  ARCHIVED
}

enum ScriptStatus {
  DRAFT
  GENERATING
  READY
  LOCKED
}

enum ScriptBlockType {
  DIALOGUE
  ACTION
  NARRATION
  DIRECTION
}

enum StoryboardStatus {
  DRAFT
  GENERATING
  READY
  LOCKED
  STALE
}

enum StoryboardShotType {
  ESTABLISHING
  WIDE
  FULL
  MEDIUM
  MEDIUM_CLOSE_UP
  CLOSE_UP
  EXTREME_CLOSE_UP
  OVER_SHOULDER
  POV
  TWO_SHOT
  INSERT
  AERIAL
  DYNAMIC
}

enum StoryboardShotSize {
  EXTREME_WIDE
  WIDE
  FULL
  MEDIUM
  MEDIUM_CLOSE_UP
  CLOSE_UP
  EXTREME_CLOSE_UP
}

enum CameraMovement {
  STATIC
  PAN
  TILT
  DOLLY_IN
  DOLLY_OUT
  TRUCK_LEFT
  TRUCK_RIGHT
  CRANE_UP
  CRANE_DOWN
  ZOOM_IN
  ZOOM_OUT
  HANDHELD
  ORBIT
  FOLLOW
  TRACKING
}

enum CameraAngle {
  EYE_LEVEL
  LOW_ANGLE
  HIGH_ANGLE
  BIRDS_EYE
  WORMS_EYE
  DUTCH_ANGLE
  OVERHEAD
}

enum StoryboardTransition {
  CUT
  FADE_IN
  FADE_OUT
  DISSOLVE
  WIPE
  MATCH_CUT
  SMASH_CUT
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  projects    Project[]
  aiProviders AiProvider[]
}

model Project {
  id                     String                   @id @default(cuid())
  name                   String
  description            String?
  genre                  String?
  cover                  String?
  status                 ProjectStatus            @default(DRAFT)
  currentStep            ProjectStep              @default(WORLD)
  userId                 String
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProviderId           String?
  aiProvider             AiProvider?              @relation("ProjectSelectedProvider", fields: [aiProviderId], references: [id], onDelete: Restrict)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  episodes               Episode[]
  characters             Character[]
  locations              Location[]
  assets                 Asset[]
  generationTasks        GenerationTask[]
  world                  World?
  storyBible             StoryBible?
  seasons                Season[]
  scripts                Script[]
  storyboards            Storyboard[]
  ownedProviders         AiProvider[]             @relation("ProviderOwnedByProject")
  characterRelationships CharacterRelationship[]
  aiConfigs              ProjectAiConfig[]
  timelines              EpisodeTimeline[]
  renderJobs             RenderJob[]
  renderArtifacts        RenderArtifact[]

  @@index([aiProviderId])
}

model StoryBible {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  logline          String?
  premise          String?
  theme            String?
  tone             String?
  style            String?
  audience         String?
  storyPromise     String?
  rules            Json?
  timelineSummary  String?
  continuityNotes  String?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Season {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  synopsis  String?
  outline   String?
  status    SeasonStatus @default(DRAFT)
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  episodes  Episode[]

  @@unique([projectId, number])
  @@index([projectId])
}

model Episode {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seasonId         String
  season           Season        @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  number           Int
  title            String
  synopsis         String?
  outline          String?
  status           EpisodeStatus @default(DRAFT)
  durationSeconds  Int?
  storyState       Json?
  continuityNotes  String?
  metadata         Json?
  order            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  script           Script?
  storyboard       Storyboard?
  audioAssets      EpisodeAudioAsset[]
  timeline         EpisodeTimeline?
  renderJobs       RenderJob[]
  renderArtifacts  RenderArtifact[]

  @@unique([seasonId, number])
  @@index([projectId])
  @@index([seasonId])
}

model Character {
  id                  String                   @id @default(cuid())
  projectId           String
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worldId             String?
  world               World?                   @relation(fields: [worldId], references: [id], onDelete: SetNull)
  civilizationId      String?
  civilization        Civilization?            @relation(fields: [civilizationId], references: [id], onDelete: SetNull)
  factionId           String?
  faction             Faction?                 @relation(fields: [factionId], references: [id], onDelete: SetNull)
  name                String
  alias               String?
  gender              String?
  age                 Int?
  race                String?
  identity            String?
  role                String?
  description         String?
  personality         String?
  appearance          String?
  background          String?
  motivation          String?
  goal                String?
  conflict            String?
  ability             String?
  personalityProfile  Json?
  appearanceProfile   Json?
  abilities           Json?
  voiceProfile        Json?
  imageProfile        Json?
  metadata            Json?
  status              CharacterStatus          @default(ACTIVE)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  outgoingRelations   CharacterRelationship[]  @relation("CharacterRelationFrom")
  incomingRelations   CharacterRelationship[]  @relation("CharacterRelationTo")
  scriptBlocks        ScriptBlock[]

  @@index([projectId])
  @@index([worldId])
  @@index([civilizationId])
  @@index([factionId])
  @@index([projectId, name])
}

model Script {
  id                       String       @id @default(cuid())
  episodeId                String       @unique
  episode                  Episode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  projectId                String
  project                  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                    String
  version                  Int          @default(1)
  status                   ScriptStatus @default(DRAFT)
  logline                  String?
  summary                  String?
  estimatedDurationSeconds Int?
  metadata                 Json?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  scenes                   Scene[]

  @@index([projectId])
}

model Scene {
  id                       String        @id @default(cuid())
  scriptId                 String
  script                   Script        @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  number                   Int
  title                    String
  location                 String?
  locationId               String?
  locationRef              Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  timeOfDay                String?
  summary                  String?
  purpose                  String?
  conflict                 String?
  estimatedDurationSeconds Int?
  metadata                 Json?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  blocks                   ScriptBlock[]
  storyboardShots          StoryboardShot[]

  @@unique([scriptId, number])
  @@index([scriptId])
  @@index([locationId])
}

model ScriptBlock {
  id          String          @id @default(cuid())
  sceneId     String
  scene       Scene           @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  order       Int
  type        ScriptBlockType
  content     String
  characterId String?
  character   Character?      @relation(fields: [characterId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  storyboardShots StoryboardShot[]
  blockAssets     ScriptBlockAsset[]

  @@unique([sceneId, order])
  @@index([sceneId])
  @@index([characterId])
}

model Storyboard {
  id                   String           @id @default(cuid())
  episodeId            String           @unique
  episode              Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version              Int              @default(1)
  status               StoryboardStatus @default(DRAFT)
  title                String
  description          String?
  totalDurationSeconds Int?
  sourceScriptVersion  Int              @default(1)
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  shots                StoryboardShot[]

  @@index([projectId])
}

model StoryboardShot {
  id                   String              @id @default(cuid())
  storyboardId         String
  storyboard           Storyboard          @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  sceneId              String?
  scene                Scene?              @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  scriptBlockId        String?
  scriptBlock          ScriptBlock?        @relation(fields: [scriptBlockId], references: [id], onDelete: SetNull)
  shotNumber           Int
  shotType             StoryboardShotType
  shotSize             StoryboardShotSize
  cameraMovement       CameraMovement
  cameraAngle          CameraAngle
  composition          String?
  visualDescription    String
  characterIds         Json?
  location             String?
  action               String?
  dialogue             String?
  narration            String?
  direction            String?
  durationSeconds      Int
  transition           StoryboardTransition @default(CUT)
  lighting             String?
  mood                 String?
  visualStyle          String?
  imagePrompt          String?
  videoPrompt          String?
  negativePrompt       String?
  continuityNotes      String?
  cameraMovementParams Json?
  metadata             Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  shotAssets           StoryboardShotAsset[]

  @@unique([storyboardId, shotNumber])
  @@index([storyboardId])
  @@index([sceneId])
  @@index([scriptBlockId])
}

model CharacterRelationship {
  id              String                 @id @default(cuid())
  projectId       String
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromCharacterId String
  fromCharacter   Character              @relation("CharacterRelationFrom", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacterId   String
  toCharacter     Character              @relation("CharacterRelationTo", fields: [toCharacterId], references: [id], onDelete: Cascade)
  type            CharacterRelationType
  label           String?
  description     String?
  strength        Int                    @default(3)
  metadata        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([fromCharacterId, toCharacterId, type])
  @@index([projectId])
  @@index([fromCharacterId])
  @@index([toCharacterId])
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  environment String?
  atmosphere  String?
  visualStyle String?
  tags        Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scenes      Scene[]

  @@index([projectId])
  @@index([projectId, name])
}

model Asset {
  id               String                @id @default(cuid())
  projectId        String
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             AssetType
  status           AssetStatus           @default(READY)
  name             String
  mimeType         String?
  storageKey       String?
  url              String?
  thumbnailUrl     String?
  width            Int?
  height           Int?
  durationSeconds  Float?
  sizeBytes        Int?
  provider         String?
  model            String?
  version          Int                   @default(1)
  generationTaskId String?
  generationTask   GenerationTask?       @relation(fields: [generationTaskId], references: [id], onDelete: SetNull)
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  shotAssets       StoryboardShotAsset[]
  blockAssets      ScriptBlockAsset[]
  episodeAssets    EpisodeAudioAsset[]
  timelineClips    TimelineClip[]

  @@index([projectId])
  @@index([generationTaskId])
}

model ScriptBlockAsset {
  id            String               @id @default(cuid())
  scriptBlockId String
  scriptBlock   ScriptBlock          @relation(fields: [scriptBlockId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  role          ScriptBlockAssetRole
  isPrimary     Boolean              @default(false)
  sortOrder     Int                  @default(0)
  metadata      Json?
  createdAt     DateTime             @default(now())

  @@unique([scriptBlockId, assetId])
  @@index([scriptBlockId])
  @@index([assetId])
}

model EpisodeAudioAsset {
  id        String         @id @default(cuid())
  episodeId String
  episode   Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  role      AudioAssetRole
  isPrimary Boolean        @default(false)
  sortOrder Int            @default(0)
  metadata  Json?
  createdAt DateTime       @default(now())

  @@unique([episodeId, assetId])
  @@index([episodeId])
  @@index([assetId])
}

model StoryboardShotAsset {
  id        String                   @id @default(cuid())
  shotId    String
  shot      StoryboardShot           @relation(fields: [shotId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset                    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  role      StoryboardShotAssetRole
  isPrimary Boolean                  @default(false)
  sortOrder Int                      @default(0)
  metadata  Json?
  createdAt DateTime                 @default(now())

  @@unique([shotId, assetId])
  @@index([shotId])
  @@index([assetId])
}

model GenerationTask {
  id         String                @id @default(cuid())
  projectId  String
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       GenerationTaskType
  status     GenerationTaskStatus  @default(PENDING)
  capability AiCapability?
  provider   String?
  model      String?
  input      Json?
  output     Json?
  error      String?
  usage      Json?
  appliedAt  DateTime?
  retryCount Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  assets     Asset[]

  @@index([projectId])
}

model AiProvider {
  id                 String                 @id @default(cuid())
  name               String
  provider           AiProviderKind
  baseUrl            String
  model              String
  encryptedApiKey    String
  isDefault          Boolean                @default(false)
  enabled            Boolean                @default(true)
  userId             String?
  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId          String?
  ownedByProject     Project?               @relation("ProviderOwnedByProject", fields: [projectId], references: [id], onDelete: SetNull)
  selectedByProjects Project[]              @relation("ProjectSelectedProvider")
  capabilities       AiProviderCapability[]
  models             AiModel[]
  projectAiConfigs   ProjectAiConfig[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([isDefault, enabled])
}

model AiProviderCapability {
  id         String       @id @default(cuid())
  providerId String
  provider   AiProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  capability AiCapability
  enabled    Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([providerId, capability])
  @@index([providerId])
}

model AiModel {
  id               String            @id @default(cuid())
  providerId       String
  provider         AiProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name             String
  modelId          String
  capabilities     AiCapability[]
  enabled          Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  projectAiConfigs ProjectAiConfig[]

  @@unique([providerId, modelId])
  @@index([providerId])
}

model ProjectAiConfig {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capability AiCapability
  providerId String?
  provider   AiProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  modelId    String?
  model      AiModel?     @relation(fields: [modelId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([projectId, capability])
  @@index([projectId])
  @@index([providerId])
}

model World {
  id               String          @id @default(cuid())
  projectId        String          @unique
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  summary          String?
  cosmicBackground String?
  coreConflict     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  civilizations    Civilization[]
  histories        WorldHistory[]
  factions         Faction[]
  worldLocations   WorldLocation[]
  powerSystems     PowerSystem[]
  characters       Character[]
}

model Civilization {
  id             String          @id @default(cuid())
  worldId        String
  world          World           @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  origin         String?
  philosophy     String?
  society        String?
  culture        String?
  technology     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  factions       Faction[]
  worldLocations WorldLocation[]
  characters     Character[]

  @@index([worldId])
}

model WorldHistory {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
}

model Faction {
  id             String        @id @default(cuid())
  worldId        String
  world          World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  civilizationId String?
  civilization   Civilization? @relation(fields: [civilizationId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  type           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  characters     Character[]

  @@index([worldId])
}

model WorldLocation {
  id             String        @id @default(cuid())
  worldId        String
  world          World         @relation(fields: [worldId], references: [id], onDelete: Cascade)
  civilizationId String?
  civilization   Civilization? @relation(fields: [civilizationId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  type           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([worldId])
}

model PowerSystem {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rules       Json?
  levels      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([worldId])
}

model EpisodeTimeline {
  id                         String         @id @default(cuid())
  projectId                  String
  project                    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeId                  String         @unique
  episode                    Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  version                    Int            @default(1)
  status                     TimelineStatus @default(DRAFT)
  durationSeconds            Float          @default(0)
  fps                        Int            @default(24)
  resolution                 String         @default("1920x1080")
  aspectRatio                String         @default("16:9")
  sourceStoryboardVersion    Int?
  sourceScriptVersion        Int?
  sourceAssetVersionSummary  Json?
  metadata                   Json?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  tracks                     TimelineTrack[]
  renderJobs                 RenderJob[]

  @@index([projectId])
}

model TimelineTrack {
  id         String            @id @default(cuid())
  timelineId String
  timeline   EpisodeTimeline   @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  type       TimelineTrackType
  name       String
  order      Int               @default(0)
  enabled    Boolean           @default(true)
  muted      Boolean           @default(false)
  volume     Float             @default(1)
  metadata   Json?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  clips      TimelineClip[]

  @@index([timelineId])
}

model TimelineClip {
  id               String                 @id @default(cuid())
  trackId          String
  track            TimelineTrack          @relation(fields: [trackId], references: [id], onDelete: Cascade)
  type             TimelineClipType
  sourceType       TimelineClipSourceType
  sourceId         String
  assetId          String
  asset            Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  startTime        Float
  duration         Float
  sourceStartTime  Float                  @default(0)
  sourceDuration   Float
  zIndex           Int                    @default(0)
  volume           Float                  @default(1)
  speed            Float                  @default(1)
  opacity          Float                  @default(1)
  enabled          Boolean                @default(true)
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([trackId])
  @@index([assetId])
  @@index([sourceType, sourceId])
}

model RenderJob {
  id                 String           @id @default(cuid())
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeId          String
  episode            Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  timelineId         String
  timeline           EpisodeTimeline  @relation(fields: [timelineId], references: [id], onDelete: Restrict)
  timelineVersion    Int
  status             RenderJobStatus  @default(QUEUED)
  manifestSnapshot   Json
  outputFormat       String           @default("h264_aac")
  outputContainer    String           @default("mp4")
  width              Int
  height             Int
  fps                Int
  durationSeconds    Float
  progress           Float?
  currentStage       RenderJobStage   @default(QUEUED)
  outputArtifactId   String?
  errorCode          String?
  errorMessage       String?
  attempt            Int              @default(1)
  maxAttempts        Int              @default(3)
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  failedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  events             RenderJobEvent[]
  artifacts          RenderArtifact[]

  @@index([projectId])
  @@index([episodeId])
  @@index([timelineId])
  @@index([status])
  @@index([createdAt])
  @@index([projectId, episodeId, timelineId, timelineVersion])
}

model RenderJobEvent {
  id          String              @id @default(cuid())
  renderJobId String
  renderJob   RenderJob           @relation(fields: [renderJobId], references: [id], onDelete: Cascade)
  type        RenderJobEventType
  message     String?
  progress    Float?
  metadata    Json?
  createdAt   DateTime            @default(now())

  @@index([renderJobId])
}

model RenderArtifact {
  id               String             @id @default(cuid())
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeId        String
  episode          Episode            @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  renderJobId      String
  renderJob        RenderJob          @relation(fields: [renderJobId], references: [id], onDelete: Cascade)
  type             RenderArtifactType @default(EPISODE_VIDEO)
  storageKey       String
  mimeType         String             @default("video/mp4")
  fileSize         Int
  durationSeconds  Float?
  width            Int?
  height           Int?
  fps              Float?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([renderJobId])
  @@index([projectId])
  @@index([episodeId])
}
