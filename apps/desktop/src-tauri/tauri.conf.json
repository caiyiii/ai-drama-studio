{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Drama Studio",
  "version": "0.0.1",
  "identifier": "studio.aidrama.desktop",
  "build": {
    "beforeDevCommand": "vite --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Drama Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
